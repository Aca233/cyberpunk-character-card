{
  "name": "@cp/web",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.node.json",
    "dev": "vite",
    "dev:local": "VITE_CP_BACKEND=local vite",
    "build": "pnpm --dir ../.. check-assets && vite build",
    "build:static": "pnpm --dir ../.. check-assets && VITE_CP_BACKEND=local vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@cp/content": "workspace:*",
    "@cp/core": "workspace:*",
    "@cp/server": "workspace:*",
    "@fontsource-variable/noto-sans-sc": "^5.3.1",
    "@fontsource/rajdhani": "^5.3.0",
    "@tanstack/react-query": "^5.104.5",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "^8.5.0",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "vite": "^8.3.5"
  }
}
