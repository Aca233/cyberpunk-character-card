{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": { "enabled": false },
  "files": {
    "includes": [
      "**",
      "!**/node_modules",
      "!pnpm-lock.yaml",
      "!**/dist",
      "!apps/web/public/assets/local",
      "!reference",
      "!data",
      "!tools/evals/results",
      "!tools/evals/drafts",
      "!.playwright-mcp",
      "!.run",
      "!packages/content/src/roadSpots.gen.ts"
    ]
  },
  "formatter": { "enabled": true, "indentStyle": "space", "indentWidth": 2, "lineWidth": 100 },
  "linter": { "enabled": true, "rules": { "preset": "recommended" } },
  "assist": { "actions": { "source": { "organizeImports": "on" } } },
  "overrides": [
    {
      "includes": ["packages/core/**", "packages/content/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "react": "core 和 content 不能依赖 React，界面代码放在 apps/web",
                  "react-dom": "core 和 content 不能依赖 React，界面代码放在 apps/web",
                  "hono": "core 和 content 不能依赖路由框架，运行时接口放在 packages/runtime"
                },
                "patterns": [
                  {
                    "group": ["node:*", "node:*/**"],
                    "message": "core 和 content 不能直接用 Node 模块，通过 kernel/ports.ts 的接口注入"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["packages/runtime/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@cp/web", "@cp/web/**", "**/web", "**/web/**"],
                    "message": "runtime 不能引用 web；共享类型和规则放在 packages/core"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["apps/web/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "@cp/runtime",
                      "@cp/runtime/**",
                      "**/runtime",
                      "**/runtime/**",
                      "!@cp/runtime/browser"
                    ],
                    "message": "web 不能直接引用 runtime 内部模块；唯一入口是 api/transport.ts 引用 @cp/runtime/browser"
                  },
                  {
                    "group": ["node:*", "node:*/**"],
                    "message": "web 不能直接使用 Node 模块；本地存储与模型适配放在 packages/runtime"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["packages/core/src/systems/*/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "react": "core 和 content 不能依赖 React，界面代码放在 apps/web",
                  "react-dom": "core 和 content 不能依赖 React，界面代码放在 apps/web",
                  "hono": "core 和 content 不能依赖路由框架，运行时接口放在 packages/runtime"
                },
                "patterns": [
                  {
                    "group": ["node:*", "node:*/**"],
                    "message": "core 和 content 不能直接用 Node 模块，通过 kernel/ports.ts 的接口注入"
                  },
                  {
                    "group": ["../*/*", "../*/**", "!../../**", "!../*/index"],
                    "message": "系统之间只能引用对方目录的入口（../dice），不能读内部文件；依赖要写进 dependsOn"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["packages/core/**", "packages/content/**", "apps/web/**"],
      "linter": {
        "rules": {
          "correctness": { "noNodejsModules": "error" }
        }
      }
    }
  ]
}
