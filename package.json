{
  "name": "cyberpunk-character-card",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --filter @cp/web dev",
    "build": "pnpm --filter @cp/web build",
    "preview": "pnpm --filter @cp/web preview",
    "deploy": "pnpm build && npx wrangler pages deploy apps/web/dist --project-name cyberpunk",
    "push": "tsx tools/publish.ts",
    "typecheck": "pnpm -r --parallel run typecheck",
    "lint": "biome check .",
    "format": "biome check --write .",
    "check": "pnpm typecheck && pnpm lint && pnpm check-data",
    "eval": "pnpm --filter @cp/tools run eval",
    "pick-assets": "pnpm --filter @cp/tools run pick-assets",
    "check-assets": "pnpm --filter @cp/tools run check-assets",
    "terms": "pnpm --filter @cp/tools run terms",
    "check-data": "pnpm --filter @cp/tools run check-data"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.2",
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
